# Корневой .gitignore. Внутри lead_orchestrator/ действует ещё свой — он не отменён,
# правила gitignore применяются к своему поддереву.

# Изолированное окружение Kimi-стадии: воспроизводится из lead_orchestrator_kimi/requirements.txt
# + patches/apply_patches.py, весит сотни МБ и содержит патч в site-packages — в git ему делать
# нечего. Со звёздочкой: правило ловит и бэкапы вида .venv_kimi_bak_1.48.
lead_orchestrator_kimi/.venv_kimi*/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Локальные настройки инструментов (у каждого свои). Без ведущего слэша — правило
# действует в ЛЮБОЙ подпапке, а не только в корне.
settings.local.json

# Секреты и данные Docker-запуска: .env/папка env с токенами и том ./docker-data —
# в git им не место (см. DEPLOY_TIMEWEB.md: env/.env, никогда не коммитить).
.env
/env/
docker-data/

# Артефакты прогонов
*.pdf
*.log
out.html
raw.html

# Локальные браузерные бинарники и операционные выгрузки лидов. Это не исходники:
# архивы велики, а JSON/TXT могут содержать реальные компании и контакты.
/.tools/
/chromedriver-win64.zip
/rusprofile_*.json
/rusprofile_*.txt
/lead_orchestrator/cit_lead.json

# Служебная папка прогона в корне репо (штатная живёт в D:\orq_tmp, эта заводится,
# когда скрипт запущен с ORQ_DATA_ROOT по умолчанию из другого каталога) — там
# смоук-выгрузки Фазы 1 с реальными компаниями.
/orq_tmp/

# Вендорённый сторонний коннектор почты: интеграция откачена коммитом 4748257,
# исходники остались лежать локально. Вернётся — вернётся зависимостью, не копией.
/mcp_mail/

# Мусор от случайных редиректов/ОС (пустые файлы «Яндекс» завелись в обеих папках)
Яндекс
Thumbs.db
desktop.ini

# Служебная папка ассистента Hermes (планы сессий) — не исходники.
.hermes/
