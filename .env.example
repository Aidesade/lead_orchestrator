# ==============================================================================
# lead_gen — шаблон окружения.
#
#   1. Скопировать:   copy .env.example env\.env      (Linux: cp .env.example env/.env)
#   2. Заполнить ТОЛЬКО то, что нужно выбранному режиму (см. разделы ниже).
#
# Папка env/ целиком в .gitignore — реальный env/.env в репозиторий не попадает.
# Десктоп/CLI подхватывают env/.env тихо через lead_orchestrator/project_env.py
# (ORQ_ENV_FILE перекрывает путь); Docker — через env_file в docker-compose.yml.
# Значения ниже — кодовые дефолты; закомментированное трогать не обязательно.
# Пустое значение ≠ «дефолт»: для секретов пустая строка означает «стадия выключена».
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. LLM-runtime. Штат ветки — Claude Agent SDK; ORQ_KIMI_ONLY=1 возвращает Kimi целиком.
# ------------------------------------------------------------------------------
ORQ_LLM_RUNTIME=claude            # claude | kimi
ORQ_KIMI_ONLY=0                   # 1 = полный Kimi-режим (Docker-образ живёт так), перекрывает всё
DR_LLM_PROVIDER=claude            # провайдер LLM-экстракта движка ресёрча (по runtime: claude | kimi)

# Claude: авторизация — логин Claude Code (~/.claude) ЛИБО ключ API. В контейнере логина нет.
#ANTHROPIC_API_KEY=

# Kimi (нужен при ORQ_LLM_RUNTIME=kimi / ORQ_KIMI_ONLY=1 / --model kimi). Фолбэк ключа — GPLLM_API_KEY.
#KIMI_API_KEY=
#GPLLM_API_KEY=
#KIMI_BASE_URL=https://gpllmkeeper.dtc.tatar/v1
#KIMI_MODEL_NAME=kimi-k2.7-code

# Модели claude-стадий (алиасы CLI: opus | sonnet | haiku)
#ORQ_WRITER_MODEL=opus            # писатель двух .docx
#ORQ_ENRICH_MODEL=sonnet          # пять enrichment-ролей
#ORQ_ONEPAGER_MODEL=opus          # one-pager
#ORQ_CONTROLLER_MODEL=sonnet      # NL-контроллер
#ORQ_SCOUT_MODEL=sonnet           # субагенты писателя
#ORQ_CRITIC_MODEL=sonnet
#ORQ_VERIFIER_MODEL=sonnet
#DR_EXTRACT_MODEL=sonnet          # экстракт движка ресёрча
#ORQ_LETTER_MODEL=sonnet          # текст письма (outreach)


# ------------------------------------------------------------------------------
# 2. ФАЗА 1 — источник компаний
# ------------------------------------------------------------------------------
LEAD_SOURCE=rusprofile            # rusprofile (дефолт, нужен Chromium) | ofdata (Docker) | checko

# RusProfile: cookie создаёт `py rusprofile_session.py --login`; проверка — `--check`
#RUSPROFILE_COOKIES_FILE=env/rusprofile_cookies.json
#RUSPROFILE_PROFILE_DIR=
#RUSPROFILE_BROWSER=playwright    # playwright | uc (undetected-chromedriver)
#RUSPROFILE_MAX_PAGES=20
#RUSPROFILE_TIMEOUT_MS=

# OfData / Checko (API-пути; OFDATA_API_KEY обязателен при LEAD_SOURCE=ofdata)
#OFDATA_API_KEY=
#OFDATA_REVENUE_SOURCE=auto       # auto | ofdata | girbo
#OFDATA_MAX_CANDIDATES=3000
#OFDATA_MAX_PAGES_PER_CODE=50
#OFDATA_CONTACTS_CAP=0            # 0 = все
#CHECKO_TOKEN=
#CHECKO_CONTACTS_CAP=100

# Обогащение реквизитов/ЛПР (опционально)
#DADATA_TOKEN=

# Строгий режим госкомпаний (--state-owned). Профиль зашит кодом; здесь только тумблеры.
#STATE_LEAD_REGION=Татарстан      # пусто или * — регион-фильтр выключен
#STATE_LEAD_REGION_CODE=16        # код субъекта для серверного фильтра RusProfile
#STATE_LEAD_TZ_LIMIT=             # N = только регионы в пределах МСК±N ч
#STATE_LEAD_OWNERSHIP=1           # 0 = не проверять госдолю (как --no-state-share)
#STATE_LEAD_MAX_SECONDS=1200
#STATE_LEAD_MAX_PAGES=
#STATE_LEAD_MAX_CANDIDATES=1000
#STATE_ROSIM_URL=                 # XLSX Росимущества для АО (HTTPS)
#STATE_ROSIM_FILE=                # локальная копия XLSX вместо URL
#STATE_ROSIM_MAX_AGE_DAYS=45
#STATE_OWNERSHIP_CACHE_TTL_H=24
#STATE_OWNERSHIP_MAX_DEPTH=6


# ------------------------------------------------------------------------------
# 3. ФАЗА 2 — движок ресёрча (deep_research_engine) и стадии
# ------------------------------------------------------------------------------
#DR_USE_LLM=1                     # 0 = regex-only, бесплатно
#DR_USE_CRAWL4AI=1                # 0 = HTTP-фолбэк вместо Crawl4AI
#DR_BREADTH=4
#DR_DEPTH=2
#DR_MAXPAGES=25
#DR_MAX_DOMAINS=3
#DR_PAGE_CHARS=9000
#DR_LLM_CONCURRENCY=2
#DR_CRAWL_CONCURRENCY=4
#DR_SEARCH_CONCURRENCY=1
#DR_SEARCH_INTERVAL=1.6
#DR_LLM_TIMEOUT=300
#DR_KIMI_MAX_TOKENS=8000
#DR_FETCH_MAX_BYTES=5242880
#FIRECRAWL_API_KEY=               # опционально: полный парсинг ЕИС/антибот-страниц

# Стадии внутри компании
#PERSON_ENRICH=1                  # прямой контакт ЛПР по ФИО+ИНН
#PERSON_VERIFY_EMAIL=0            # SMTP-проба адреса ЛПР (ВЫКЛ: долго и долбит чужие серверы)
#PERSON_SOCIAL=0                  # соцпоиск ЛПР (ВЫКЛ)
#EMAIL_GUESS=1                    # гипотезы почты ключевых сотрудников
#EMAIL_GUESS_SITE=1               # 0 = без обхода сайта
#GEN_PRESENTATION=1               # 0 = без one-pager (как --no-presentation)
#PRESALE_VENDOR=                  # строка «Подготовлено для» в .docx
#PRESALE_PLATFORM_DESC=

# Устойчивость / ресурсы
#ORQ_RESEARCH_TIMEOUT=0           # 0 = без общего дедлайна (kimi); 1800 для legacy Claude
#ORQ_ONEPAGER_TIMEOUT=900
#ORQ_ONEPAGER_CONCURRENCY=2
#ORQ_MIN_RAM_GB=2.5
#ORQ_FINDINGS_TTL_H=72

# Kimi-стадии (только при kimi-runtime)
#KIMI_WRITER_AGENT=1              # 0 = legacy одиночный HTTP-режим
#KIMI_WRITER_AGENT_TIMEOUT=0
#KIMI_WRITER_ATTEMPTS=3
#KIMI_WRITER_MAX_STEPS=
#KIMI_WRITER_THINKING=
#KIMI_WRITER_MAX_TOKENS=16000
#KIMI_WRITER_TIMEOUT=600
#KIMI_RESEARCH_SUBAGENTS_TIMEOUT=2400
#KIMI_RESEARCH_COMPANY_CONCURRENCY=2
#KIMI_RESEARCH_SUBAGENT_ATTEMPTS=2
#KIMI_RESEARCH_SUBAGENT_MAX_STEPS=
#KIMI_RESEARCH_CHECKPOINT_TTL_H=72
#KIMI_TOOL_LOG_DIR=
#ORQ_KIMI_TOOL_TIMEOUT=180
#ORQ_RESEARCH_TOOL=               # путь к мосту kimi_research_cli.py


# ------------------------------------------------------------------------------
# 4. Хранилище и пути (на Windows работают дефолты; в Docker задаёт compose)
# ------------------------------------------------------------------------------
ORQ_STORE=local                   # local (ORQ_DATA_ROOT/deliverables/<ИНН>/) | disk (Яндекс Диск)
#ORQ_DATA_ROOT=                   # корень служебных папок (в контейнере /data)
#ORQ_LEADS_DIR=                   # D:\лиды / /data/leads
#ORQ_DELIVERABLES_DIR=            # перекрывает ORQ_DATA_ROOT/deliverables
#ORQ_DELIVERABLE_KEY=
#ORQ_CACHE_DIR=
#ORQ_MAIN_PY=                     # python основного окружения (лаунчеры и мост Kimi→движок)
#ORQ_ENV_FILE=                    # другой путь к .env
#KIMI_DIR=                        # папка lead_orchestrator_kimi
#KIMI_PY=                         # python venv Kimi-стадии (.venv_kimi)

# Яндекс Диск — нужен ТОЛЬКО при ORQ_STORE=disk (scope cloud_api:disk.write)
#YANDEX_DISK_TOKEN=
#ORQ_DISK_BASE=disk:/Лиды

# Веб (web/api)
#ORQ_REPO_ROOT=
#ORQ_PYTHON=
#ORQ_WEB_JOBS_DIR=


# ------------------------------------------------------------------------------
# 5. OUTREACH — рассылка ЛПР (lead_orchestrator/outreach.py). Дефолт — ЧЕРНОВИКИ.
# ------------------------------------------------------------------------------
#OUTREACH_TRANSPORT=outlook       # outlook (Outlook Desktop, COM) | yandex (SMTP)
#OUTREACH_FROM=tatar.ru           # подстрока адреса ящика-отправителя в профиле Outlook
#OUTREACH_ONEPAGER_DIR=lead_orchestrator/assets/onepagers
#ORQ_OUTREACH_REGISTRY=           # реестр отправок, дефолт <ORQ_DATA_ROOT>/orq_outreach/registry.json

# Подпись дописывается КОДОМ, модели не отдаётся. Один подписант, два контакта — осознанно.
#OUTREACH_SIGNER_NAME=Булат Замалиев
#OUTREACH_SIGNER_POST=
#OUTREACH_CONTACT1_NAME=          # тот же контакт, что в one-pager
#OUTREACH_CONTACT1_EMAIL=
#OUTREACH_CONTACT1_PHONE=
#OUTREACH_CONTACT2_NAME=          # владелец ящика рассылки (ответы приходят сюда)
#OUTREACH_CONTACT2_EMAIL=
#OUTREACH_CONTACT2_PHONE=

# Транспорт SMTP Яндекса (при OUTREACH_TRANSPORT=yandex; без --send письма ложатся .eml в ORQ_DRAFTS_DIR)
#YANDEX_SMTP_HOST=smtp.yandex.ru
#YANDEX_SMTP_PORT=465
#YANDEX_SMTP_USER=
#YANDEX_SMTP_PASSWORD=
#YANDEX_SMTP_FROM_NAME=АО «ЦИТ РТ»
#YANDEX_SMTP_MIN_PAUSE=
#ORQ_DRAFTS_DIR=

# Стадия 9 — выгрузка лида в CRM ЦИТ РТ. Без CRM_URL+CRM_INGEST_TOKEN стадия молча выключена.
#CRM_URL=                         # https://crm.example.ru (локально http://localhost:8000)
#CRM_INGEST_TOKEN=                # = LEADGEN_INGEST_TOKEN в .env самой CRM
#CRM_PUSH=1                       # 0 = выключить, не трогая ключи
#CRM_PUSH_TIMEOUT=20


# ------------------------------------------------------------------------------
# 6. Подбор и проверка почты (email_guess / email_verify) — standalone-утилиты
# ------------------------------------------------------------------------------
# БЕЗ HELO/MAIL_FROM SMTP-проба не выполняется вовсе (представляться чужим доменом нельзя).
#EMAIL_GUESS_HELO=                # FQDN хоста с PTR, напр. verify.example.ru
#EMAIL_GUESS_MAIL_FROM=           # noreply@example.ru
#EMAIL_GUESS_MAX_BYTES=2097152
#EMAIL_GUESS_SITE_BUDGET=45
#EMAIL_VERIFY_MAX_PER_DOMAIN=

# Свой (self-hosted) верификатор, если поднят (см. DEPLOY_VERIFIER.md)
#EMAIL_VERIFIER_URL=
#EMAIL_VERIFIER_KIND=reacher      # aftership | reacher
#EMAIL_VERIFIER_SECRET=

# Облачный добор MyEmailVerifier — ВЫКЛ по умолчанию; ОПК/госсектор наружу не уходят никогда.
#EMAIL_MEV_ENABLE=0
#EMAIL_MEV_API_KEY=
#EMAIL_MEV_URL=https://api.myemailverifier.com
#EMAIL_MEV_CREDITS_URL=
#EMAIL_MEV_DAILY_LIMIT=100
#EMAIL_MEV_RPM=30
#EMAIL_MEV_DENY_INDUSTRIES=opk,government
#EMAIL_MEV_DENY_DOMAINS=gov.ru,mil.ru,mod.gov.ru,rosatom.ru,rostec.ru
#EMAIL_MEV_CACHE_TTL_D=30
